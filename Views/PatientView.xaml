<UserControl x:Class="TreatmentPlanReport.Views.PatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreatmentPlanReport.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="5">
            <TextBlock Text="Patient Id:" FontWeight="Bold"/>
            <TextBlock Text="{Binding PatientId}" Margin="5,5,0,0"/>
        </StackPanel>
        <StackPanel Margin="5" Grid.Column="1">
            <TextBlock Text="Last Name:" FontWeight="Bold"/>
            <TextBlock Text="{Binding LastName}" Margin="5,5,0,0"/>
        </StackPanel>
        <StackPanel Margin="5" Grid.Column="2">
            <TextBlock Text="First Name:" FontWeight="Bold"/>
            <TextBlock Text="{Binding FirstName}" Margin="5,5,0,0"/>
        </StackPanel>
        <Border BorderBrush="Black" BorderThickness="0,0,0,1" Grid.ColumnSpan="3"/>
        <StackPanel Margin="5" Grid.Row="1">
            <TextBlock Text="DOB: " FontWeight="Bold"/>
            <TextBlock Text="{Binding DateOfBirth}" Margin="5,5,0,0"/>
        </StackPanel>
        <StackPanel Margin="5" Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Hospital: " FontWeight="Bold"/>
            <TextBlock Text="{Binding Hospital}" Margin="5,5,0,0"/>
        </StackPanel>
        <StackPanel Margin="5" Grid.Row="1" Grid.Column="2">
            <TextBlock Text="Primary Oncologist: " FontWeight="Bold"/>
            <TextBlock Text="{Binding PrimaryOncologist}" Margin="5,5,0,0"/>
        </StackPanel>
        <Border BorderBrush="Black" BorderThickness="0,0,0,1" Grid.Row="1" Grid.ColumnSpan="3"/>
    </Grid>
</UserControl>
